# --- Zorunlu ---
# @BotFather'dan aldığınız jeton
TELEGRAM_BOT_TOKEN=

# --- Railway'de önerilen ---
# Kalıcı disk (Railway Volume) bağlama noktası. Veritabanı ve önbellek buraya yazılır;
# volume bağlamazsanız her yeniden dağıtımda veri sıfırdan indirilir.
SPORTOTO_DATA_DIR=/data

# --- Veri ---
# footballdata (varsayılan, oranlı) | mirror (oransız, 5 lig) | local | synthetic
SPORTOTO_SOURCE=footballdata
# İndirilecek ligler (kodlar için: python -m sportoto leagues)
SPORTOTO_LEAGUES=T1,E0,E1,SP1,SP2,I1,I2,D1,D2,F1,F2,N1,B1,P1,G1,SC0
# Kaç sezon geriye inilecek
SPORTOTO_SEASONS=8
# Otomatik veri tazeleme aralığı (saat). 0 = kapalı.
SPORTOTO_AUTO_UPDATE_HOURS=24

# --- Kupon ---
# Kolon birim fiyatı (TL). GÜNCEL DEĞERİ SİZ GİRİN — Spor Toto zaman zaman değiştirir.
SPORTOTO_COLUMN_PRICE=5
# Varsayılan kupon bütçesi (TL)
SPORTOTO_BUDGET=500

# --- Model (ileri düzey; varsayılanlar backtest ile seçildi) ---
# Dixon-Coles zaman ağırlığı. Büyütmek = eski maçları daha hızlı unutmak.
# SPORTOTO_DC_XI=0.0018
# Oran marjı temizleme yöntemi: power | shin | basic
# SPORTOTO_MARGIN=power
