# ─────────────────────────────────────────────────────────────────────────
# TEK ZORUNLU DEĞİŞKEN
# ─────────────────────────────────────────────────────────────────────────
# Telegram'da @BotFather → /newbot → size verdiği uzun jeton
TELEGRAM_BOT_TOKEN=

# ─────────────────────────────────────────────────────────────────────────
# İSTEĞE BAĞLI — hepsinin makul bir varsayılanı var
# ─────────────────────────────────────────────────────────────────────────

# Kolon birim fiyatı (TL). Spor Toto bunu zaman zaman günceller; güncel
# değeri girerseniz kupon bedelleri doğru hesaplanır. Varsayılan: 5
# SPORTOTO_COLUMN_PRICE=5

# Varsayılan kupon bütçesi (TL). Telegram'da /butce ile de değiştirilebilir.
# SPORTOTO_BUDGET=500

# Veri klasörü. Railway'de /data volume'ü bağlıysa KENDİLİĞİNDEN bulunur,
# bu değişkeni eklemenize gerek yoktur.
# SPORTOTO_DATA_DIR=/data

# Veri kaynağı: footballdata (varsayılan, oranlı) | mirror | local | synthetic
# SPORTOTO_SOURCE=footballdata

# İndirilecek ligler. Liste için: python -m sportoto leagues
# SPORTOTO_LEAGUES=T1,E0,E1,SP1,SP2,I1,I2,D1,D2,F1,F2,N1,B1,P1,G1,SC0

# Kaç sezon geriye inilecek (varsayılan 8)
# SPORTOTO_SEASONS=8

# Otomatik veri tazeleme aralığı, saat. 0 = kapalı. Varsayılan 24
# SPORTOTO_AUTO_UPDATE_HOURS=24

# Haftalık otomatik gönderim (/abone diyen sohbetlere).
# Gün: 0=Pazartesi … 6=Pazar. Varsayılan 3 (Perşembe)
# SPORTOTO_WEEKLY_DAY=3
# Saat: UTC. Türkiye saati için 3 çıkarın (12:00 TR = 9). Varsayılan 9
# SPORTOTO_WEEKLY_HOUR=9

# ─────────────────────────────────────────────────────────────────────────
# İLERİ DÜZEY — backtest ile seçilmiş varsayılanlar, dokunmanıza gerek yok
# ─────────────────────────────────────────────────────────────────────────
# SPORTOTO_DC_XI=0.0018        # Dixon-Coles zaman ağırlığı
# SPORTOTO_MARGIN=power        # oran marjı temizleme: power | shin | basic
